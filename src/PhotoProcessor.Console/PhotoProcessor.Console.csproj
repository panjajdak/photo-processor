<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>photoprocessor</AssemblyName>
    <RootNamespace>PhotoProcessor.Console</RootNamespace>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>photoprocessor</ToolCommandName>
    <PackageId>PhotoProcessor</PackageId>
    <Product>PhotoProcessor</Product>
    <Description>Renames photos and videos from different devices to consistent, sortable names using their metadata.</Description>
    <PackageTags>photo;video;rename;exif;metadata;organizer;cli</PackageTags>
    <PackageProjectUrl>https://github.com/panjajdak/photo-processor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/panjajdak/photo-processor</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoProcessor.Core\PhotoProcessor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="config.default.json" LogicalName="config.default.json" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PhotoProcessor.Console.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

</Project>
