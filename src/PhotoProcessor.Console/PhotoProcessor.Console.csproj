<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>photoprocessor</AssemblyName>
    <RootNamespace>PhotoProcessor.Console</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Version>2.0.0</Version>
    <Product>PhotoProcessor</Product>
    <Description>Renames photos and videos from different devices to consistent, sortable names using their metadata.</Description>
    <Authors>Jan Pajdak</Authors>
    <Copyright>Copyright © 2021-2026 Jan Pajdak</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoProcessor.Core\PhotoProcessor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

</Project>
